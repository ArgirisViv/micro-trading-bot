# Copy to .env.local and insert your own credentials. Never commit that file.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
STOCK_TRADING_URL=https://paper-api.alpaca.markets
CRYPTO_TRADING_URL=https://paper-api.alpaca.markets

POLYGON_API_KEY=
CRYPTOCOMPARE_API_KEY=
ALPHA_VANTAGE_KEY=

STOCK_WATCHLIST=AAPL,MSFT,GOOG,TSLA,AMZN
CRYPTO_WATCHLIST=BTCUSD,ETHUSD,SOLUSD,ADAUSD
ASSET_CLASSES=stocks,crypto
TIMEFRAME=5min
LOOKBACK=3

RISK_PER_TRADE=0.01
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
TRAILING_STOP_PCT=0.01
PARTIAL_CLOSE_PCT=0.02
PARTIAL_CLOSE_RATIO=0.5
MAX_PORTFOLIO_POSITIONS=4
MAX_DAILY_ORDERS=100
MAX_DAILY_DRAWDOWN_PCT=0.02
# Stock market-hour gating is mandatory for the supported paper loop.
USE_MOCK_DATA=false

# Monitoring dashboard (read-only)
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
# Optional local SQLite file for self-registered dashboard accounts.
# DASHBOARD_ACCOUNTS_DB=dashboard_accounts.sqlite3
# Only enable when accessed through HTTPS, for example behind a trusted proxy.
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_HEARTBEAT_MAX_AGE=300
# Optional absolute paths when result/state files live outside the project root:
# STATE_FILE=/path/to/state.json
# DASHBOARD_BACKTEST_CSV=/path/to/backtest_results.csv
# DASHBOARD_WALKFORWARD_CSV=/path/to/walkforward_metrics.csv
# DASHBOARD_TRADE_LOG_CSV=/path/to/trade_log.csv
# TRADE_LOG_FILE=/path/to/trade_log.csv

TELEGRAM_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=
ALERT_EMAILS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBERS=

